// Cloudflare Worker serving the browser demo at play.wildwillows.app.
//
// Deployed by .github/workflows/web-demo.yml, which builds web/ first — the SAME
// artifact it pushes to itch's html5 channel. One build, two destinations;
// detectChannel() (src/platform.ts) tells them apart at runtime from the page's
// own hostname, which is why neither is stamped with a build-time channel.
//
// WHY A SUBDOMAIN AND NOT wildwillows.app/play: the apex is a proxied CNAME to
// the hosted Harper, and Harper has to issue its own certificate for that name.
// Hanging the demo off the apex makes shipping it wait on that, and on every
// future change to it. A subdomain gets its certificate from Cloudflare
// automatically and shares nothing with the origin, so the demo can go down or
// be redeployed without touching the game API, and vice versa.
//
// The cross-origin cost is near zero here: the demo runs its own backend in-app
// (DEMO_WEB_BACKEND = 'solo'), so all it sends home are four fire-and-forget
// telemetry POSTs — and Harper already has to allow cross-origin for itch's
// demo and for the desktop app's `Origin: null`.
//
// Deploy by hand:  npx wrangler deploy
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wildwillows-play",
	// Pinned so `npx wrangler deploy` works with no env vars. Wrangler has to pick
	// an account, and a login/token that can see more than one fails with "more
	// than one account available" rather than choosing — which is a confusing way
	// to lose ten minutes. Not a secret: it appears in every dashboard URL, and
	// Cloudflare's own docs commit it.
	"account_id": "cabc4f5dbdd465a7fd1ad27e499fa1ef",
	"main": "workers/play.js",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./web",
		"binding": "ASSETS",
		// The demo is a single-page app: an unknown path should hand back the app
		// shell, not a 404, so a stale bookmark still lands in the game.
		"not_found_handling": "single-page-application",
		// Run the Worker ONLY for the HTML entry point. `run_worker_first` defaults
		// to false, which means a Worker with assets never sees requests that match
		// an asset — so the headers in play.js would silently never be applied.
		// Setting it to `true` instead would work, but bills a Worker invocation for
		// every chunk and image as well. Search engines index the page, not the JS,
		// so the entry point is the only place the robots header has to land.
		// TRUE, not a path list. The Worker now proxies ~40 gameplay endpoints, and
		// with `not_found_handling: single-page-application` any path it does NOT see
		// first is answered by the asset server with index.html and a 200 — so a
		// forgotten entry would not 404, it would return a page of HTML to a game
		// action and look like corrupt server state. An explicit list is one rename
		// away from that; routing everything through the Worker cannot drift.
		//
		// The cost is a Worker invocation per asset request as well. At Workers'
		// per-request pricing that is noise next to the correctness it buys.
		"run_worker_first": true
	},
	// A custom domain, NOT a route: Cloudflare creates the DNS record and issues
	// the certificate itself. Nothing to add by hand in the DNS tab, and nothing
	// waiting on Harper.
	"routes": [
		{
			"pattern": "play.wildwillows.app",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	}
}
