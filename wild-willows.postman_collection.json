						"body": {
							"mode": "raw",
							"raw": "{\n  \"playerId\": \"{{playerId}}\",\n  \"appearance\": {\n    \"skin\": \"#d9a06b\",\n    \"hair\": \"#a3692f\",\n    \"outfit\": \"#7a9ac0\",\n    \"hat\": \"leaf\",\n    \"hairstyle\": \"long\",\n    \"body\": \"round\"\n  }\n}"
						},
						"url": {
