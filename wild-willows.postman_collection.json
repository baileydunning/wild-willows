					}
				},
				{
					"name": "Delete Player",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{name}}\",\n  \"passcode\": \"{{passcode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/DeletePlayer/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"DeletePlayer",
								""
							]
						},
						"description": "Permanently delete a save and all of its records (placements, chests, biome states, discoveries, terrain). Requires the correct passcode."
					}
				}
			]
		},
