{
	"info": {
		"name": "Wild Willows API",
		"_postman_id": "b1c0f7a2-4d3e-4f1a-9c2b-wildwillows01",
		"description": "REST collection for the Wild Willows Harper backend (resources.js).\n\nEvery game action goes through a validated custom resource — the frontend never writes tables directly.\n\n## Getting started\n1. Run Harper locally: `npm run dev` (serves on https://localhost:9926).\n2. Harper uses a self-signed certificate, so in Postman go to **Settings → General → SSL certificate verification = OFF**, or the requests will fail with a cert error.\n3. Run **Auth → Create Player** (or **Login**) first — it auto-saves the returned `playerId` into the `playerId` collection variable, which every other request reuses.\n\n## Variables\n- `baseUrl` — API origin (default https://localhost:9926)\n- `playerId` — set automatically on create/login\n- `name`, `passcode` — credentials used by auth requests\n- `chestId` — defaults to the starter chest `pl_{{playerId}}_starter-chest`\n- `area` — current biome (meadow, forest, wetland, desert, alpine, coastal)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://wild.willows.harperfabric.com",
			"type": "string"
		},
		{
			"key": "playerId",
			"value": "demo",
			"type": "string"
		},
		{
			"key": "name",
			"value": "Demo",
			"type": "string"
		},
		{
			"key": "passcode",
			"value": "1234",
			"type": "string"
		},
		{
			"key": "chestId",
			"value": "pl_demo_starter-chest",
			"type": "string"
		},
		{
			"key": "area",
			"value": "meadow",
			"type": "string"
		},
		{
			"key": "harperUser",
			"value": "",
			"type": "string"
		},
		{
			"key": "harperPass",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Reference (read-only)",
			"item": [
				{
					"name": "GameData",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/GameData/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"GameData",
								""
							]
						},
						"description": "All static game definitions: biomes, animals, resources, recipes, habitat objects, tools, and appearance options. No auth required."
					}
				},
				{
					"name": "GameState (by playerId)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/GameState/{{playerId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"GameState",
								"{{playerId}}"
							]
						},
						"description": "Full per-player snapshot: player record (passcode stripped), biome states, placements, chests, discoveries, node states, and terrain."
					}
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Create Player",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"if (j && j.playerId) {",
									"  pm.collectionVariables.set('playerId', j.playerId);",
									"  pm.collectionVariables.set('chestId', 'pl_' + j.playerId + '_starter-chest');",
									"}",
									"pm.test('created ok', () => pm.expect(j.ok).to.be.true);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{name}}\",\n  \"passcode\": \"{{passcode}}\",\n  \"appearance\": {\n    \"skin\": \"#eec39a\",\n    \"hair\": \"#6e4a33\",\n    \"outfit\": \"#4a7c59\",\n    \"hat\": \"straw\",\n    \"hairstyle\": \"short\",\n    \"body\": \"slim\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/CreatePlayer/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"CreatePlayer",
								""
							]
						},
						"description": "Create a new save. name 2–24 chars, passcode ≥4 chars. Returns playerId + fresh state snapshot. Auto-saves playerId to the collection variable."
					}
				},
				{
					"name": "Login Player",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const j = pm.response.json();",
									"if (j && j.playerId) {",
									"  pm.collectionVariables.set('playerId', j.playerId);",
									"  pm.collectionVariables.set('chestId', 'pl_' + j.playerId + '_starter-chest');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{name}}\",\n  \"passcode\": \"{{passcode}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/LoginPlayer/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"LoginPlayer",
								""
							]
						},
						"description": "Load an existing save by name + passcode. Auto-saves playerId to the collection variable."
					}
				},
