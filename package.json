{
	"name": "wild-willows",
	"version": "0.1.0",
	"private": true,
	"description": "Wild Willows — a cozy nature-restoration life sim, backed by Harper",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev:web": "vite",
		"dev": "npm run build:server && harper dev .",
		"build": "npm run build:server && npm run build:web",
		"build:web": "vite build",
		"build:server": "esbuild server/resources.ts --bundle --format=esm --platform=node --packages=external --outfile=resources.js",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"phaser": "^3.85.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"esbuild": "^0.24.0",
		"typescript": "^5.6.3",
		"vite": "^5.4.11"
	}
}
