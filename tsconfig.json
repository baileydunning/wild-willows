{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"resolveJsonModule": true
	},
	"include": ["src", "server"]
}
