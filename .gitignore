# note: web/ (built frontend), resources.js (built backend), and server/pages.ts
# (policy HTML inlined from public/ by scripts/build-pages.mjs) are committed on
# purpose — the desktop build packages web/ as-is, deploy-coop.sh ships the
# committed resources.js, and the integration tests import it directly.
node_modules/
*.log
.DS_Store
# Vite/Vitest write a temp config bundle on each build; sometimes it isn't cleaned up
vite.config.*.timestamp-*.mjs
vitest.config.*.timestamp-*.mjs

# desktop (Electron / electron-builder) build output
dist/

# Steam: dev-only app id file (Steam injects the real id in packaged builds)
steam_appid.txt

# Mac App Store: provisioning profile (CI decodes it from the
# MAS_PROVISIONING_PROFILE secret; keep the local copy out of git)
build/embedded.provisionprofile

# iOS (Capacitor): the ios/ project is committed, but CocoaPods output and the
# synced copy of web/ inside it are generated by `npm run ios:sync` / Xcode
ios/App/Pods/
ios/App/App/public/
ios/App/output/
ios/DerivedData/
ios/App/App/capacitor.config.json

# test + coverage output
coverage/
playwright-report/
test-results/
.playwright/
