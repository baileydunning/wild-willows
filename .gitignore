# note: web/ (built frontend) and resources.js (built backend) are committed
# on purpose — `harper deploy package=.` ships the directory as-is.
node_modules/
*.log
.DS_Store
# Vite writes a temp config bundle on each build; sometimes it isn't cleaned up
vite.config.*.timestamp-*.mjs

# desktop (Electron / electron-builder) build output
dist/

# Steam: dev-only app id file (Steam injects the real id in packaged builds)
steam_appid.txt

# Mac App Store: provisioning profile (CI decodes it from the
# MAS_PROVISIONING_PROFILE secret; keep the local copy out of git)
build/embedded.provisionprofile

# test + coverage output
coverage/
playwright-report/
test-results/
.playwright/
