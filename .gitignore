# note: web/ (built frontend), resources.js (built backend), and server/pages.ts
# (policy HTML inlined from public/ by scripts/build-pages.mjs) are committed on
# purpose — the desktop build packages web/ as-is, deploy-coop.sh ships the
# committed resources.js, and the integration tests import it directly.
node_modules/
*.log
.DS_Store
# Vite/Vitest write a temp config bundle on each build; sometimes it isn't cleaned up
vite.config.*.timestamp-*.mjs
vitest.config.*.timestamp-*.mjs

# desktop (Electron / electron-builder) build output
dist/

# Steam: dev-only app id file (Steam injects the real id in packaged builds)
steam_appid.txt

# Mac App Store: provisioning profile (CI decodes it from the
# MAS_PROVISIONING_PROFILE secret; keep the local copy out of git)
build/embedded.provisionprofile

# Python bytecode from the gating scripts (scripts/gating/*.py)
__pycache__/
*.pyc

# test + coverage output
coverage/
playwright-report/
test-results/
.playwright/

# Android (Capacitor) — the whole native project is GENERATED by
# `npm run android:init` from the @capacitor/android template, then patched by
# scripts/patch-android.mjs. Regenerate it rather than committing it; every
# setting that matters lives in that script, which is idempotent.
android/

# Android signing — the release keystore and any local env file feeding it.
# Losing the keystore means you can never update the app under the same Play
# listing again, so keep the backup somewhere that is not this repo.
*.jks
*.keystore
android-signing.env
# The base64 blob IS the keystore, and the readme carries its password.
keystore-base64.txt
ANDROID_KEYSTORE_README.txt

# Scratch: files the remote bridge could not delete directly.
_to_delete/
